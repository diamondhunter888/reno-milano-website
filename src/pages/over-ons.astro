---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const waarden = [
  {
    nummer: '01',
    titel: 'Kwaliteit',
    tekst: 'Wij werken uitsluitend met kwalitatieve materialen en bewezen technieken. Elk project wordt met dezelfde zorg afgewerkt, groot of klein.',
  },
  {
    nummer: '02',
    titel: 'Betrouwbaarheid',
    tekst: 'Duidelijke communicatie, eerlijke prijzen en afspraken nakomen. Dat is de basis van elke samenwerking bij Reno Milano.',
  },
  {
    nummer: '03',
    titel: 'Vakmanschap',
    tekst: 'Onze ervaren vaklieden brengen jarenlange kennis mee. Van dakwerken tot badkamerafwerking: het detail maakt het verschil.',
  },
];
---
<BaseLayout title="Over ons" description="Leer meer over Reno Milano, uw renovatiepartner in Antwerpen.">
  <PageHero
    eyebrow="Wie zijn wij"
    title="Over<br><em style='font-weight:300;font-style:italic;'>Ons</em>"
    sub="Meer dan tien jaar renovatieervaring in Antwerpen en omgeving."
    bg="Over"
  />

  <!-- Verhaal -->
  <section class="verhaal">
    <div class="verhaal__inner">
      <div class="verhaal__tekst" data-anim="fade-up">
        <div class="verhaal__eyebrow-row">
          <div class="verhaal__line"></div>
          <p class="label">Ons verhaal</p>
        </div>
        <h2 class="verhaal__titel">
          Renovatie met<br><em>passie en precisie</em>
        </h2>
        <p class="verhaal__body">Reno Milano is een renovatiebedrijf gevestigd in het hart van Antwerpen. Met meer dan tien jaar ervaring in woningrenovatie, dakwerken, badkamers en keukens hebben wij honderden Antwerpse gezinnen een mooier, comfortabeler thuis gegeven.</p>
        <p class="verhaal__body">Wij geloven dat een geslaagde renovatie begint bij goed luisteren. Uw wensen, uw stijl, uw budget — dat is ons vertrekpunt. Van het eerste gesprek tot de laatste afwerking staan wij voor u klaar met eerlijk advies en vakkundige uitvoering.</p>
        <a href="/contact" class="btn-outline verhaal__cta">Neem contact op</a>
      </div>
      <div class="verhaal__media" data-anim="fade-in" style="--anim-delay: 0.15s">
        <img src="/images/hero-interior.png" alt="Reno Milano renovatie interieur" loading="lazy" />
        <div class="verhaal__media-tag">
          <span class="label" style="color: rgba(218,221,216,0.6);">Est. 2014</span>
          <p class="verhaal__media-loc">Antwerpen, België</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Waarden -->
  <section class="waarden">
    <div class="waarden__inner">
      <div class="waarden__header" data-anim="fade-up">
        <p class="label" style="color: var(--clr-mid);">Waar wij voor staan</p>
        <h2 class="waarden__titel">
          Onze<br><em>Waarden</em>
        </h2>
      </div>
      <ol class="waarden__lijst" role="list">
        {waarden.map((w, i) => (
          <li class="waarden__item" data-anim="fade-up" style={`--anim-delay: ${i * 0.1}s`}>
            <span class="waarden__nr" aria-hidden="true">{w.nummer}</span>
            <div class="waarden__body">
              <h3 class="waarden__naam">{w.titel}</h3>
              <p class="waarden__tekst">{w.tekst}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Erkend aannemer -->
  <section class="erkend">
    <div class="erkend__inner" data-anim="fade-up">
      <div class="erkend__content">
        <div class="erkend__eyebrow-row">
          <div class="erkend__line"></div>
          <p class="label">Erkend aannemer</p>
        </div>
        <h2 class="erkend__titel">Volledig gecertificeerd<br>en verzekerd.</h2>
        <p class="erkend__tekst">Reno Milano is een geregistreerde aannemer en voldoet aan alle wettelijke vereisten voor renovatiewerken in België. Wij werken conform de Belgische bouwregelgeving en bieden volledige garantie op al onze werken.</p>
      </div>
      <a href="/contact" class="btn-outline erkend__cta">Neem contact op</a>
    </div>
  </section>
</BaseLayout>

<style>
/* ── Verhaal ── */
.verhaal {
  background: var(--clr-warm);
  padding-block: var(--spacing-xl);
  padding-inline: var(--spacing-container-pad);
}

.verhaal__inner {
  max-width: 1200px;
  margin-inline: auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-lg);
  align-items: center;
}

.verhaal__eyebrow-row {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

.verhaal__line {
  width: 48px;
  height: 1px;
  background: rgba(28,28,28,0.3);
  flex-shrink: 0;
}

.verhaal__titel {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4.5vw, 3.5rem);
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -0.02em;
  color: var(--clr-black);
  margin-bottom: 1.75rem;
}

.verhaal__titel em { font-weight: 300; font-style: italic; }

.verhaal__body {
  font-size: 0.9375rem;
  color: rgba(28,28,28,0.78);
  line-height: 1.8;
  margin-bottom: 1rem;
}

.verhaal__cta {
  margin-top: 1rem;
  color: var(--clr-black);
  border-color: var(--clr-black);
}

.verhaal__media {
  position: relative;
}

.verhaal__media img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  display: block;
}

.verhaal__media-tag {
  position: absolute;
  bottom: 1.5rem;
  left: 1.5rem;
  background: rgba(28,28,28,0.75);
  backdrop-filter: blur(8px);
  padding: 0.75rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.verhaal__media-loc {
  font-size: 0.75rem;
  color: rgba(218,221,216,0.5);
}

/* ── Waarden ── */
.waarden {
  background: var(--clr-black);
  padding-block: var(--spacing-xl);
  padding-inline: var(--spacing-container-pad);
}

.waarden__inner {
  max-width: 1200px;
  margin-inline: auto;
}

.waarden__header {
  display: flex;
  align-items: flex-end;
  gap: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  padding-bottom: var(--spacing-md);
  border-bottom: 1px solid rgba(218,221,216,0.12);
}

.waarden__titel {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -0.02em;
  color: var(--clr-white);
}

.waarden__titel em { font-weight: 300; font-style: italic; }

.waarden__lijst {
  list-style: none;
  margin: 0;
  padding: 0;
}

.waarden__item {
  display: grid;
  grid-template-columns: 3.5rem 1fr;
  gap: 2rem;
  align-items: start;
  padding: 2rem 0;
  border-bottom: 1px solid rgba(218,221,216,0.1);
}

.waarden__nr {
  font-family: var(--font-display);
  font-size: 0.75rem;
  letter-spacing: 0.15em;
  color: rgba(218,221,216,0.45);
  padding-top: 0.25rem;
}

.waarden__naam {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 2.5vw, 2rem);
  font-weight: 700;
  color: var(--clr-white);
  margin-bottom: 0.75rem;
  letter-spacing: 0.01em;
}

.waarden__tekst {
  font-size: 0.875rem;
  color: rgba(218,221,216,0.82);
  line-height: 1.75;
  max-width: 540px;
}

/* ── Erkend ── */
.erkend {
  background: var(--clr-warm);
  padding-block: var(--spacing-xl);
  padding-inline: var(--spacing-container-pad);
}

.erkend__inner {
  max-width: 1200px;
  margin-inline: auto;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--spacing-lg);
}

.erkend__eyebrow-row {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

.erkend__line {
  width: 48px;
  height: 1px;
  background: rgba(28,28,28,0.3);
  flex-shrink: 0;
}

.erkend__titel {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3.25rem);
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -0.02em;
  color: var(--clr-black);
  margin-bottom: 1.25rem;
}

.erkend__tekst {
  font-size: 0.9375rem;
  color: rgba(28,28,28,0.75);
  line-height: 1.75;
  max-width: 520px;
}

.erkend__cta {
  color: var(--clr-black);
  border-color: var(--clr-black);
  flex-shrink: 0;
  align-self: flex-end;
}

@media (max-width: 768px) {
  .verhaal__inner { grid-template-columns: 1fr; }
  .erkend__inner { flex-direction: column; align-items: flex-start; }
  .erkend__cta { width: 100%; justify-content: center; }
  .waarden__item { grid-template-columns: 2.5rem 1fr; gap: 1rem; }
}
</style>
