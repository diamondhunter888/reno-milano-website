---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const projecten = [
  {
    naam: 'Totaalrenovatie',
    locatie: 'Borgerhout',
    categorie: 'Woningrenovatie',
    omschrijving: 'Volledige renovatie van een rijwoning inclusief vloeren, schilderwerk en badkamer.',
    foto: '/images/dienst-woning.png',
    groot: true,
  },
  {
    naam: 'Dakrenovatie',
    locatie: 'Merksem',
    categorie: 'Dakwerken',
    omschrijving: 'Volledige vervanging van het dak met nieuwe isolatie en ventilatie.',
    foto: '/images/dienst-woning.png',
    groot: false,
  },
  {
    naam: 'Luxe badkamer',
    locatie: 'Berchem',
    categorie: 'Badkamer',
    omschrijving: 'Moderne inloopdouche, vrijstaand bad en maatwerk meubels.',
    foto: '/images/dienst-badkamer.png',
    groot: false,
  },
  {
    naam: 'Open keuken',
    locatie: 'Wilrijk',
    categorie: 'Keuken',
    omschrijving: 'Keuken op maat met eiland, inductie en natuurstenen werkblad.',
    foto: '/images/dienst-keuken.png',
    groot: false,
  },
  {
    naam: 'Appartementrenovatie',
    locatie: 'Antwerpen Centrum',
    categorie: 'Woningrenovatie',
    omschrijving: 'Renovatie van een appartement inclusief nieuwe vloeren en plafonds.',
    foto: '/images/hero-interior.png',
    groot: true,
  },
  {
    naam: 'Badkamer & Keuken',
    locatie: 'Deurne',
    categorie: 'Badkamer & Keuken',
    omschrijving: 'Gecombineerde renovatie van badkamer en keuken in één project.',
    foto: '/images/dienst-badkamer.png',
    groot: false,
  },
];
---
<BaseLayout title="Realisaties" description="Bekijk de realisaties van Reno Milano: renovatieprojecten in Antwerpen en omgeving.">
  <PageHero
    eyebrow="Ons werk"
    title="Realisaties"
    sub="Elk project vertelt een verhaal. Ontdek wat wij al voor onze klanten hebben gerealiseerd."
    bg="Werk"
  />

  <section class="porto">
    <div class="porto__inner">

      <div class="porto__grid">
        {projecten.map((p, i) => (
          <article
            class={`porto__item${p.groot ? ' porto__item--groot' : ''}`}
            data-anim="fade-in"
            style={`--anim-delay: ${(i % 3) * 0.1}s`}
          >
            <div class="porto__img-wrap">
              <img src={p.foto} alt={`${p.naam} — ${p.locatie}`} loading="lazy" />
              <div class="porto__tag">
                <span class="label">{p.categorie}</span>
              </div>
            </div>
            <div class="porto__info">
              <div class="porto__info-top">
                <h3 class="porto__naam">{p.naam}</h3>
                <span class="porto__locatie">{p.locatie}</span>
              </div>
              <p class="porto__omschrijving">{p.omschrijving}</p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="real-cta">
    <div class="real-cta__inner" data-anim="fade-up">
      <p class="label" style="color: var(--clr-mid); margin-bottom: 1.25rem;">Uw woning aan de beurt?</p>
      <h2 class="real-cta__title">
        <em>Wij realiseren</em><br>ook uw project.
      </h2>
      <a href="/contact" class="btn-outline real-cta__btn">Offerte aanvragen</a>
    </div>
  </section>
</BaseLayout>

<style>
/* ── Portfolio grid ── */
.porto {
  background: var(--clr-black);
  padding-block: var(--spacing-xl);
  padding-inline: var(--spacing-container-pad);
}

.porto__inner {
  max-width: 1200px;
  margin-inline: auto;
}

.porto__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}

.porto__item {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.porto__item--groot {
  grid-column: span 2;
}

.porto__img-wrap {
  position: relative;
  overflow: hidden;
  aspect-ratio: 4 / 3;
}

.porto__item--groot .porto__img-wrap {
  aspect-ratio: 16 / 9;
}

.porto__img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
  filter: brightness(0.82);
}

.porto__item:hover .porto__img-wrap img {
  transform: scale(1.05);
  filter: brightness(0.95);
}

.porto__tag {
  position: absolute;
  top: 1rem;
  left: 1rem;
  background: rgba(28,28,28,0.7);
  backdrop-filter: blur(8px);
  padding: 0.35rem 0.75rem;
}

.porto__tag .label { color: rgba(218,221,216,0.8); }

.porto__info {
  padding: 1.25rem 0;
  border-bottom: 1px solid rgba(218,221,216,0.1);
}

.porto__info-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 0.5rem;
}

.porto__naam {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 2vw, 1.4rem);
  font-weight: 700;
  color: var(--clr-white);
  line-height: 1.2;
}

.porto__locatie {
  font-size: 0.6875rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(218,221,216,0.6);
  white-space: nowrap;
  flex-shrink: 0;
}

.porto__omschrijving {
  font-size: 0.8125rem;
  color: rgba(218,221,216,0.75);
  line-height: 1.65;
}

/* ── CTA ── */
.real-cta {
  background: var(--clr-black);
  padding-block: var(--spacing-xl);
  padding-inline: var(--spacing-container-pad);
  border-top: 1px solid rgba(218,221,216,0.1);
}

.real-cta__inner {
  max-width: 1200px;
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 2rem;
}

.real-cta__title {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--clr-white);
}

.real-cta__title em {
  font-weight: 300;
  font-style: italic;
  color: var(--clr-mid);
}

.real-cta__btn {
  color: var(--clr-mid);
  border-color: rgba(218,221,216,0.4);
}

@media (max-width: 1024px) {
  .porto__grid { grid-template-columns: repeat(2, 1fr); }
  .porto__item--groot { grid-column: span 2; }
}
@media (max-width: 640px) {
  .porto__grid { grid-template-columns: 1fr; }
  .porto__item--groot { grid-column: span 1; }
  .porto__item--groot .porto__img-wrap { aspect-ratio: 4 / 3; }
}
</style>
