---
const previews = [
  { src: '/images/hero-interior.png', alt: 'Woningrenovatie — interieur afwerking', span: true },
  { src: '/images/dienst-badkamer.png', alt: 'Badkamerrenovatie — moderne stijl', span: false },
  { src: '/images/dienst-keuken.png', alt: 'Keukenrenovatie — op maat', span: false },
];
---
<section class="section rp">
  <div class="rp__inner">

    <div class="rp__header" data-anim="fade-up">
      <h2 class="rp__title">
        <em class="rp__title-thin">Ons</em>
        <span class="rp__title-bold">Werk</span>
      </h2>
      <div class="rp__header-right">
        <p class="rp__sub">Elk project is uniek.<br>Elk resultaat is uitmuntend.</p>
        <a href="/realisaties" class="btn-outline rp__cta">Alle realisaties →</a>
      </div>
    </div>

    <div class="rp__grid">
      {previews.map((p, i) => (
        <div
          class={`rp__item${p.span ? ' rp__item--wide' : ''}`}
          data-anim="fade-in"
          style={`--anim-delay: ${i * 0.12}s`}
        >
          <img src={p.src} alt={p.alt} class="rp__img" loading="lazy" />
          <div class="rp__caption">
            <span class="label" style="color: var(--clr-mid);">{p.alt}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
.rp {
  background: var(--clr-black);
  padding-block: var(--spacing-xl);
}

.rp__inner {
  max-width: 1200px;
  margin-inline: auto;
  padding-inline: var(--spacing-container-pad);
}

.rp__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
  padding-bottom: var(--spacing-md);
  border-bottom: 1px solid rgba(218,221,216,0.12);
}

.rp__title {
  font-family: var(--font-display);
  font-size: clamp(3rem, 8vw, 6rem);
  line-height: 0.9;
  letter-spacing: -0.02em;
  display: flex;
  flex-direction: column;
}

.rp__title-thin {
  font-weight: 300;
  font-style: italic;
  color: var(--clr-mid);
}

.rp__title-bold {
  font-weight: 800;
  font-style: normal;
  color: var(--clr-white);
  letter-spacing: 0.02em;
}

.rp__header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 1.5rem;
  text-align: right;
  max-width: 320px;
}

.rp__sub {
  font-size: clamp(0.875rem, 1.5vw, 1rem);
  font-weight: 300;
  color: rgba(218,221,216,0.6);
  line-height: 1.6;
}

.rp__cta {
  color: var(--clr-mid);
  border-color: rgba(218,221,216,0.4);
  white-space: nowrap;
}

.rp__cta:hover {
  background: var(--clr-white);
  color: var(--clr-black);
  border-color: var(--clr-white);
}

.rp__grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  grid-template-rows: auto auto;
  gap: 0.75rem;
}

.rp__item {
  position: relative;
  overflow: hidden;
}

.rp__item--wide {
  grid-row: span 2;
}

.rp__img {
  width: 100%;
  height: 100%;
  min-height: 240px;
  object-fit: cover;
  display: block;
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
  filter: brightness(0.85);
}

.rp__item:hover .rp__img {
  transform: scale(1.05);
  filter: brightness(0.95);
}

.rp__item--wide .rp__img {
  min-height: 500px;
}

.rp__caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1rem 1.25rem;
  background: linear-gradient(to top, rgba(28,28,28,0.7), transparent);
}

@media (max-width: 640px) {
  .rp__grid {
    grid-template-columns: 1fr;
    grid-template-rows: auto;
  }
  .rp__item--wide { grid-row: auto; }
  .rp__item--wide .rp__img { min-height: 280px; }
  .rp__header { flex-direction: column; align-items: flex-start; }
  .rp__header-right { align-items: flex-start; text-align: left; }
}
</style>
