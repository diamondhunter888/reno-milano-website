---
---
<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <img src="/images/hero-interior.jpg" alt="" fetchpriority="high" />
    <div class="hero__media-overlay"></div>
  </div>

  <div class="hero__content">
    <div class="hero__top">
      <div class="hero__line"></div>
      <p class="hero__eyebrow label">Antwerpen · België · Est. 2014</p>
    </div>

    <h1 class="hero__title">
      <span class="hero__title-row">
        <em class="hero__thin">Reno</em>
        <span class="hero__bold">Milano</span>
      </span>
    </h1>

    <div class="hero__bottom">
      <p class="hero__sub">
        Uw woning verdient het<br>allerbeste vakmanschap.
      </p>
      <div class="hero__actions">
        <a href="/realisaties" class="btn-solid">Onze realisaties</a>
        <a href="/contact" class="hero__link">Gratis offerte →</a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero__scroll" aria-hidden="true">
    <span class="label">Scroll</span>
    <div class="hero__scroll-line"></div>
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: 100vh;
  background: #111;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: var(--spacing-xl) var(--spacing-container-pad);
  padding-top: calc(var(--nav-height) + var(--spacing-lg));
  overflow: hidden;
}

/* Full-bleed photo background */
.hero__media {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 40%;
  display: block;
  animation: hZoom 12s ease both;
}

@keyframes hZoom {
  from { transform: scale(1.06); }
  to   { transform: scale(1); }
}

/* Dark gradient overlay — heavier at left for text legibility, lighter at right */
.hero__media-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to right,
      rgba(15,13,12,0.88) 0%,
      rgba(15,13,12,0.72) 45%,
      rgba(15,13,12,0.30) 75%,
      rgba(15,13,12,0.18) 100%
    ),
    linear-gradient(to top,
      rgba(15,13,12,0.55) 0%,
      transparent 40%
    );
}

/* Content sits above the photo */
.hero__content {
  position: relative;
  z-index: 1;
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.hero__top {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.hero__line {
  width: 48px;
  height: 1px;
  background: var(--clr-mid);
  flex-shrink: 0;
  transform-origin: left;
  animation: hLineGrow 0.7s cubic-bezier(0.16,1,0.3,1) both 0.3s;
}

.hero__eyebrow {
  color: var(--clr-mid);
  animation: hFadeUp 0.6s ease both 0.5s;
}

.hero__title {
  font-family: var(--font-display);
  line-height: 0.9;
  letter-spacing: -0.02em;
}

.hero__title-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.25em;
}

.hero__thin {
  font-size: clamp(5rem, 16vw, 14rem);
  font-weight: 300;
  font-style: italic;
  color: var(--clr-white);
  display: inline-block;
  animation: hReveal 0.85s cubic-bezier(0.16,1,0.3,1) both 0.65s;
}

.hero__bold {
  font-size: clamp(5rem, 16vw, 14rem);
  font-weight: 800;
  font-style: normal;
  color: var(--clr-white);
  letter-spacing: 0.02em;
  display: inline-block;
  animation: hReveal 0.85s cubic-bezier(0.16,1,0.3,1) both 0.85s;
}

.hero__bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--spacing-md);
  padding-top: var(--spacing-sm);
  border-top: 1px solid rgba(218,221,216,0.18);
  animation: hFadeUp 0.7s ease both 1.1s;
}

.hero__sub {
  font-size: clamp(1rem, 2vw, 1.25rem);
  font-weight: 300;
  color: var(--clr-mid);
  line-height: 1.5;
  max-width: 320px;
}

.hero__actions {
  display: flex;
  align-items: center;
  gap: 2rem;
  flex-shrink: 0;
}

.hero__link {
  font-size: 0.75rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--clr-mid);
  transition: color 0.2s;
  white-space: nowrap;
}

.hero__link:hover { color: var(--clr-white); }

/* Scroll indicator */
.hero__scroll {
  position: absolute;
  bottom: 2.5rem;
  left: var(--spacing-container-pad);
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  animation: hFadeIn 0.8s ease both 1.5s;
}

.hero__scroll .label {
  writing-mode: vertical-rl;
  font-size: 0.5625rem;
  letter-spacing: 0.3em;
  color: rgba(218,221,216,0.5);
}

.hero__scroll-line {
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, rgba(218,221,216,0.5), transparent);
  transform-origin: top;
  animation: hScrollDrop 1s cubic-bezier(0.16,1,0.3,1) both 1.8s;
}

/* Entrance keyframes */
@keyframes hFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes hFadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes hLineGrow {
  from { transform: scaleX(0); }
  to   { transform: scaleX(1); }
}

@keyframes hReveal {
  from { clip-path: inset(0 100% 0 0); opacity: 0.5; }
  to   { clip-path: inset(0 0% 0 0);   opacity: 1; }
}

@keyframes hScrollDrop {
  from { transform: scaleY(0); opacity: 0; }
  to   { transform: scaleY(1); opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .hero__media img { animation: none; }
  .hero__line,
  .hero__eyebrow,
  .hero__thin,
  .hero__bold,
  .hero__bottom,
  .hero__scroll,
  .hero__scroll-line {
    animation: none;
    opacity: 1;
    clip-path: none;
    transform: none;
  }
}

@media (max-width: 768px) {
  .hero__bottom {
    flex-direction: column;
    align-items: flex-start;
  }
  .hero__scroll { display: none; }
  /* On mobile, slightly more overlay for small screens */
  .hero__media-overlay {
    background:
      linear-gradient(to right,
        rgba(15,13,12,0.85) 0%,
        rgba(15,13,12,0.65) 100%
      ),
      linear-gradient(to top,
        rgba(15,13,12,0.5) 0%,
        transparent 40%
      );
  }
}
</style>
