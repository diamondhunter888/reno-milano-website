---
const stats = [
  { cijfer: '10+', label: 'Jaar ervaring', detail: 'Actief in Antwerpen sinds 2014' },
  { cijfer: '200+', label: 'Tevreden klanten', detail: 'Van appartement tot villa' },
  { cijfer: '100%', label: 'Kwaliteitsgarantie', detail: 'Op elk project dat we leveren' },
];
---
<section class="section section--dark stats">
  <div class="stats__inner">

    <div class="stats__header" data-anim="slide-left">
      <div class="stats__header-line"></div>
      <p class="label" style="color: var(--clr-mid);">In cijfers</p>
    </div>

    <div class="stats__grid">
      {stats.map((s, i) => (
        <div class="stats__item" data-anim="fade-up" style={`--anim-delay: ${i * 0.12}s`}>
          <span class="stats__cijfer" data-count>{s.cijfer}</span>
          <div class="stats__meta">
            <span class="stats__label">{s.label}</span>
            <span class="stats__detail">{s.detail}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
.stats {
  padding-block: var(--spacing-xl);
}

.stats__inner {
  max-width: 1200px;
  margin-inline: auto;
  padding-inline: var(--spacing-container-pad);
}

.stats__header {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-bottom: var(--spacing-lg);
}

.stats__header-line {
  width: 48px;
  height: 1px;
  background: var(--clr-mid);
  flex-shrink: 0;
}

.stats__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
}

.stats__item {
  padding: var(--spacing-md);
  border-left: 1px solid rgba(218,221,216,0.15);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.stats__item:first-child {
  border-left: none;
  padding-left: 0;
}

.stats__index {
  font-size: 0.5625rem;
  letter-spacing: 0.3em;
  color: rgba(218,221,216,0.35);
  font-weight: 600;
  text-transform: uppercase;
}

.stats__cijfer {
  font-family: var(--font-display);
  font-size: clamp(3.5rem, 8vw, 6rem);
  font-weight: 300;
  font-style: italic;
  color: var(--clr-white);
  line-height: 1;
  letter-spacing: -0.02em;
}

.stats__meta {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding-top: 0.5rem;
  border-top: 1px solid rgba(218,221,216,0.12);
}

.stats__label {
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--clr-mid);
}

.stats__detail {
  font-size: 0.8125rem;
  color: rgba(218,221,216,0.5);
  line-height: 1.5;
}

@media (max-width: 640px) {
  .stats__grid {
    grid-template-columns: 1fr;
  }
  .stats__item {
    border-left: none;
    padding-left: 0;
    border-top: 1px solid rgba(218,221,216,0.15);
    padding-top: var(--spacing-md);
  }
  .stats__item:first-child { border-top: none; padding-top: 0; }
}
</style>
